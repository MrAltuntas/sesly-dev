{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "i18n/**/*",
        "outDir": "dist"
      },
      {
        "include": "modules/legal-documents/content/*.md",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
