# sesly-dev yerel yığını: ortam değişkenleri
#
# Kullanım: cp env.example .env  (sonra gerçek anahtarları doldur)
# Yığın .env olmadan da açılır; bu dosyadaki dolu değerler zaten varsayılanlardır.
# Boş bırakılan her anahtarın özelliği kapalı kalır (bkz. README, "Çalıştırma").
# Dosya olarak verilen anahtarlar kökteki secrets/ klasörüne konur; backend
# kabında /app/secrets altında salt okunur görünür.
# Ayrıntılı envanter: Erlik vault, Areas/YMSLab/engineering/sesly-dev/2026-11-sesly-env-inventory.md
#
# Biçim: AD=deger. Değerleri tırnaksız yaz; satır sonuna yorum ekleme.
# Compose'un sabitlediği, buradan değişmeyen backend değişkenleri: NODE_ENV
# (development), PORT (3000), DATABASE_URL (aşağıdaki POSTGRES_* değerlerinden
# üretilir), REDIS_HOST, REDIS_PORT, REDIS_PASSWORD (yığındaki Redis parolasız).

# ---------------------------------------------------------------------------
# postgres (compose servisi)
# ---------------------------------------------------------------------------
# Veritabanı kullanıcısı (yalnız yerel). Harf, rakam ve alt çizgi kullan: bağlantı adresine yazılır.
POSTGRES_USER=sesly_local
# Veritabanı parolası (yalnız yerel). Harf, rakam ve alt çizgi kullan. Volume oluştuktan sonra değiştirirsen: docker compose down -v
POSTGRES_PASSWORD=sesly_local_dev_password
# Veritabanı adı.
POSTGRES_DB=sesly_local

# ---------------------------------------------------------------------------
# sesly-backend: temel
# ---------------------------------------------------------------------------
# Kullanıcı erişim jetonunun imza sırrı (yalnız yerel değer; gerçek ortamda uzun rastgele değer).
JWT_SECRET=local-dev-only-jwt-secret
# Kullanıcı yenileme jetonunun imza sırrı (yalnız yerel değer).
JWT_REFRESH_SECRET=local-dev-only-jwt-refresh-secret
# Yönetici erişim jetonunun imza sırrı (yalnız yerel değer).
JWT_ADMIN_SECRET=local-dev-only-jwt-admin-secret
# Yönetici yenileme jetonunun imza sırrı (yalnız yerel değer).
JWT_ADMIN_REFRESH_SECRET=local-dev-only-jwt-admin-refresh-secret
# Erişim jetonunun ömrü.
JWT_EXPIRES_IN=1h
# Yenileme jetonunun ömrü.
JWT_REFRESH_EXPIRES_IN=7d
# İlk yönetici (SUPER_ADMIN) hesabının e-postası; yalnız veritabanında yönetici yokken kullanılır.
ADMIN_EMAIL=admin@sesly.local
# İlk yönetici hesabının parolası (yalnız yerel; en az 8 karakter).
ADMIN_PASSWORD=sesly-local-admin
# Ek CORS kökenleri, virgülle ayrılmış (yönetim paneli ve site).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002
# Sitenin adresi: şifre sıfırlama bağlantısı ve e-postalardaki web adresi.
FRONTEND_URL=http://localhost:3002
# API'nin dış adresi (kod okuyor, kullanan yer yok).
API_URL=http://localhost:3000
# Mobil derin bağlantı şeması (kod okuyor, kullanan yer yok).
MOBILE_DEEP_LINK=sesly://
# Günlük düzeyi; debug ya da verbose ayrıntılı HTTP günlüğü açar.
LOG_LEVEL=log

# ---------------------------------------------------------------------------
# sesly-backend: Firebase (mobil giriş, şifre sıfırlama, FCM anlık bildirim)
# ---------------------------------------------------------------------------
# Firebase Admin servis hesabı JSON dosyası. Gerçek dosyayı secrets/firebase-service-account.json olarak koy.
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
# Burada olmayanlar: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,
# FIREBASE_DATABASE_URL. Kod okuyor ama etkileri yok (dosya yolu her zaman önce
# gelir); yığın bunları backend'e geçirmez.

# ---------------------------------------------------------------------------
# sesly-backend: Google Cloud (Cloud Storage ve Google TTS)
# ---------------------------------------------------------------------------
# Google Cloud proje kimliği. Boş olamaz (backend açılmaz); yer tutucu yalnız açılış içindir, gerçek proje kimliğiyle değiştir.
GOOGLE_CLOUD_PROJECT_ID=sesly-local
# Google Cloud servis hesabı JSON dosyası (Storage ve Text-to-Speech). Gerçek dosyayı secrets/google-cloud-service-account.json olarak koy.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-cloud-service-account.json
# Cloud Storage kova adı (kod varsayılanı; gerçek kovanın adıyla değiştir).
GOOGLE_STORAGE_BUCKET=sesly-storage

# ---------------------------------------------------------------------------
# sesly-backend: web OAuth (mobil giriş için gerekmez)
# ---------------------------------------------------------------------------
# Google OAuth istemci kimliği (web akışı /auth/google). Gerçek değer: Google Cloud Console, Credentials.
GOOGLE_CLIENT_ID=
# Google OAuth istemci sırrı. Gerçek anahtar.
GOOGLE_CLIENT_SECRET=
# Google OAuth dönüş adresi.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Apple ile girişte jetonun beklenen alıcısı (boşsa io.sesly.app). Mobil app.config.js de aynı adı okur.
APPLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# sesly-backend: Cartesia (ses klonlama ve klon sesle seslendirme)
# ---------------------------------------------------------------------------
# Cartesia API anahtarı. Gerçek anahtar.
CARTESIA_API_KEY=
# Cartesia API adresi.
CARTESIA_API_URL=https://api.cartesia.ai
# Cartesia API sürümü.
CARTESIA_VERSION=2026-08-14

# ---------------------------------------------------------------------------
# sesly-backend: Gemini (bölümleme, değerlendirme, çeviri)
# ---------------------------------------------------------------------------
# Gemini API anahtarı. Gerçek anahtar.
GEMINI_API_KEY=
# Gemini API adresi.
GEMINI_API_URL=https://generativelanguage.googleapis.com

# ---------------------------------------------------------------------------
# sesly-backend: Resend (e-posta)
# ---------------------------------------------------------------------------
# Resend API anahtarı. Gerçek anahtar.
RESEND_API_KEY=
# Gönderen adresi; Resend'de doğrulanmış alan adından olmalı (boşsa kod varsayılanı).
EMAIL_FROM=

# ---------------------------------------------------------------------------
# sesly-backend: Google Play abonelikleri
# ---------------------------------------------------------------------------
# Play paket adı.
GOOGLE_PACKAGE_NAME=com.sesly
# Play Developer API servis hesabı JSON dosyası. Gerçek dosyayı secrets/google-play-service-account.json olarak koy.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/app/secrets/google-play-service-account.json
# Play Pub/Sub webhook'unun beklediği alıcı (audience). Gerçek değer.
GOOGLE_PLAY_PUBSUB_AUDIENCE=
# Play Pub/Sub aboneliğinin servis hesabı e-postası. Gerçek değer.
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# sesly-backend: App Store abonelikleri
# ---------------------------------------------------------------------------
# App Store paket kimliği.
APPLE_BUNDLE_ID=com.sesly
# Uygulamanın sayısal Apple kimliği (App Store Connect). Production verisi için gerçek değer.
APPLE_APP_APPLE_ID=
# Önce denenecek ortam: Production ya da Sandbox.
APPLE_ENVIRONMENT=Production
# Sandbox verisi de kabul edilsin mi.
APPLE_ALLOW_SANDBOX=true
# Apple kök sertifikalarının klasörü (sertifika repoda).
APPLE_ROOT_CERTS_DIR=./assets/apple-root-certs
# App Store Server API anahtar kimliği. Gerçek değer.
APPLE_IAP_KEY_ID=
# App Store Server API yayıncı kimliği (issuer). Gerçek değer.
APPLE_IAP_ISSUER_ID=
# App Store Server API anahtarı (.p8). Gerçek dosyayı secrets/apple-iap-key.p8 olarak koy.
APPLE_IAP_PRIVATE_KEY_PATH=/app/secrets/apple-iap-key.p8

# ---------------------------------------------------------------------------
# sesly-backend: çalışma zamanı ayarlarının ortam yedeği
# (yönetim panelinden verilen değer önce gelir; boş değer kod varsayılanıdır)
# ---------------------------------------------------------------------------
# İstek sınırı penceresi, saniye.
RATE_LIMIT_TTL_SECONDS=60
# Pencere başına uç nokta ve kullanıcı için istek sınırı.
RATE_LIMIT_MAX_REQUESTS=300
# Arayüz metinlerinin varsayılan dili.
DEFAULT_LOCALE=tr
# Arayüz metinlerinin yedek dili.
FALLBACK_LOCALE=tr
# Açık masal dilleri, virgülle ayrılmış.
CONTENT_ENABLED_LANGUAGES=tr
# Varsayılan masal dili.
CONTENT_DEFAULT_LANGUAGE=tr
# Gemini modeli.
GEMINI_MODEL=gemini-3-flash-preview
# Gemini sıcaklığı.
GEMINI_TEMPERATURE=0.2
# Gemini düşünme bütçesi (0 kapalı, -1 model karar verir).
GEMINI_THINKING_BUDGET=0
# Gemini zaman aşımı, milisaniye.
GEMINI_TIMEOUT_MS=120000
# Masalın dil seviyesi otomatik belirlensin mi.
LLM_AUTO_ASSESS_LEVEL=true
# Masalın yaş grubu otomatik belirlensin mi.
LLM_AUTO_ASSESS_AGE_GROUP=true
# Varsayılan seslendirme sağlayıcısı: cartesia ya da google.
TTS_PROVIDER=cartesia
# Google TTS konuşma hızı.
TTS_GOOGLE_SPEAKING_RATE=0.92
# Google TTS ses perdesi.
TTS_GOOGLE_PITCH=-2
# Ses klonlama dilleri, virgülle ayrılmış (boş: desteklenen bütün diller).
VOICE_CLONE_LANGUAGES=
# Cartesia modeli.
CARTESIA_MODEL=sonic-3.6
# Cartesia varsayılan hız.
CARTESIA_DEFAULT_SPEED=0.85
# Cartesia varsayılan ses düzeyi.
CARTESIA_DEFAULT_VOLUME=1
# Cartesia varsayılan duygu.
CARTESIA_DEFAULT_EMOTION=neutral
# Art arda bölümler tek istekte seslendirilsin mi.
TTS_GROUP_SEGMENTS=true
# Hazır ses seslendirmeleri kullanıcılar arasında paylaşılsın mı.
TTS_SHARE_PRESET_AUDIO=true

# ---------------------------------------------------------------------------
# sesly-admin-frontend (derleme sırasında gömülür; değiştirince yeniden derle)
# ---------------------------------------------------------------------------
# Yönetim panelinin konuştuğu API adresi (tarayıcıdan görünen adres).
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# sesly-frontend, site (derleme sırasında gömülür; değiştirince yeniden derle)
# ---------------------------------------------------------------------------
# Sitenin hukuk metinlerini çektiği API adresi (tarayıcıdan görünen adres).
VITE_API_BASE_URL=http://localhost:3000
# Firebase web yapılandırması, e-posta eylem sayfası (/auth/action) için. Sır değil; gerçek projeden gelir, isteğe bağlı.
VITE_FIREBASE_API_KEY=
# Firebase web yapılandırması: auth alan adı. İsteğe bağlı.
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase web yapılandırması: proje kimliği. İsteğe bağlı.
VITE_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# sesly-mobile (compose servisi değil; app.config.js okur, bkz. README)
# ---------------------------------------------------------------------------
# Geliştirme derlemesinde API adresi (Android emülatöründe http://10.0.2.2:3000).
BASE_URL=http://localhost:3000
# Yayın derlemesinde API adresi.
BASE_URL_PRODUCTION=https://api.sesly.io
# Geliştirme derlemesinde Socket.IO adresi.
WEBSOCKET_URL=ws://localhost:3000
# Yayın derlemesinde Socket.IO adresi.
WEBSOCKET_URL_PRODUCTION=wss://api.sesly.io
# Google ile girişin web istemci kimliği. Gerçek değer (sır değil): Firebase Console, Authentication.
GOOGLE_WEB_CLIENT_ID=
# Firebase proje numarası (kod okuyor, kullanan yer yok).
GOOGLE_PROJECT_NUMBER=
# Firebase proje kimliği (kod okuyor, kullanan yer yok).
GOOGLE_PROJECT_ID=
# Apple girişinin dönüş adresi (kod okuyor, kullanan yer yok).
APPLE_REDIRECT_URI=
# Firebase auth alan adı (kod okuyor, kullanan yer yok).
FIREBASE_APP_DOMAIN=
# Firebase depolama kovası (kod okuyor, kullanan yer yok).
FIREBASE_STORAGE_BUCKET=
# Firebase istemci API anahtarı (kod okuyor, kullanan yer yok).
GOOGLE_API_KEY=
# Android paket adı (app.config.js aktarıyor, okuyan kod yok).
ANDROID_PACKAGE_NAME=
# iOS paket kimliği (app.config.js aktarıyor, okuyan kod yok).
IOS_BUNDLE_ID=
# Uygulama şeması (app.config.js aktarıyor, okuyan kod yok).
APP_SCHEME=
# Yalnız geliştirme derlemesi ve E2E: Firebase Auth emülatörünün adresi.
FIREBASE_AUTH_EMULATOR_HOST=
# Yalnız geliştirme derlemesi: 1 ise Maestro koşularında LogBox katmanını gizler.
E2E=
